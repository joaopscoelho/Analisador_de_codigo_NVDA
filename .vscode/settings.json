{
  // Receita de compilacao sem latexmk (que exige Perl, ausente no MiKTeX).
  // A primeira receita e a padrao e roda ao salvar.

  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ],
      "env": {}
    },
    {
      "name": "biber",
      "command": "biber",
      "args": ["%DOCFILE%"],
      "env": {}
    }
  ],

  "latex-workshop.latex.recipes": [
    {
      "name": "completo (pdflatex > biber > pdflatex x2)",
      "tools": ["pdflatex", "biber", "pdflatex", "pdflatex"]
    },
    {
      "name": "rapido (so pdflatex)",
      "tools": ["pdflatex"]
    }
  ],

  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.autoBuild.run": "onSave",

  // Fixa o arquivo raiz: sem isto o LaTeX Workshop pode escolher o
  // UFV-modelo-TCC.antes-da-revisao.tex, que tambem tem \documentclass.
  "latex-workshop.latex.search.rootFiles.include": [
    "Parte escrita/UFV-modelo-TCC.tex"
  ],
  "latex-workshop.latex.search.rootFiles.exclude": [
    "**/*.antes-da-revisao.tex"
  ]
}
